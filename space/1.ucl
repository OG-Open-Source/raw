_HttpHandler {
	HandleRequest($method:str, $path:str) -> (:str) {
		/* 使用統一的 ?{} 結構進行路由 */
		$response :str = 
    ?{$method; $path
			"GET"; "/"       |> { Txt("Welcome home!") }
			"GET"; "/users"  |> { @[db:users.list()] } /* 假設從 db 來源獲取數據 */
			"POST"; "/users" |> {
				/* 可以在執行體內進行更多操作 */
				$new_user_data = @[request:body]
				$result = @[db:users.create($new_user_data)]
				Txt("User created with ID: {}", $result[id])
			}
			* |> { "404 Not Found" }
		}
		return $response
	}
}

Main() {
	$users:arr = ["Alice", "Bob"]
	$first_user:str = $users[1]

	$config:dic = {
		port: 8080,
		debug_mode: @[env:DEBUG_MODE]
	}
	$port:i032 = $config[port]

	Txt("First user is: {}", $first_user)
	Txt("Running on port: {}", $port)

	HttpHandler.HandleRequest("GET", "/")
}